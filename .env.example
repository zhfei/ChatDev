# ============================================================================
# LLM Provider Configuration
# ============================================================================
# BASE_URL and API_KEY are the standard configurations for model call authentication.
# These variables support OpenAI, Gemini, LM Studio, Ollama, and other providers.

BASE_URL=https://api.openai.com/v1
API_KEY=sk-your-openai-api-key-here

# Disabled by default. Enable only for trusted workflows; this is not a sandbox.
# Covers Python nodes, code_save_and_run, execute_code, uv tools, Manim, and local MCP.
# Set in the server environment; workflow vars and tool env overrides cannot enable it.
MAC_ALLOW_UNSAFE_CODE_EXECUTION=0

# Example BASE_URL values:
# - OpenAI:    https://api.openai.com/v1
# - Gemini:    https://generativelanguage.googleapis.com
# - LM Studio: http://localhost:1234/v1
# - Ollama:    http://localhost:11434/v1

# ============================================================================
# Optional: Web Search and Reading Tools
# ============================================================================

# SERPER_DEV_API_KEY=your-serper-api-key-here
# Get from: https://serper.dev

# JINA_API_KEY=your-jina-api-key-here
# Get from: https://jina.ai

# ============================================================================
# One-command VPS deployment: bash deploy/publish.sh
# ============================================================================
# Copy this file to the repository root as .env. It is loaded by Bash:
# quote values containing spaces, $ or # with single quotes. Never commit .env.
# Set API_KEY and BASE_URL above to your real model provider configuration.
# Bailian example: BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
DEPLOY_HOST=120.26.22.130
DEPLOY_USER=root
DEPLOY_PORT=22
# Absolute remote directory, writable by DEPLOY_USER; no spaces.
DEPLOY_PATH=/opt/chatdev
# Optional local SSH private key PATH, NOT its contents. Empty uses SSH agent/config.
# Supports ~/.ssh/... . Password authentication can prompt via SSH;
# do not put your SSH password or private key contents in this file.
DEPLOY_SSH_KEY=
# Optional unique image tag; empty generates timestamp + Git commit automatically.
DEPLOY_VERSION=
# Optional trusted certificate bundle for builds behind a corporate proxy.
# BUILD_CA_BUNDLE=/path/to/trusted-ca-bundle.crt
# Prerequisites: local Docker (linux/amd64 builds), Bash, Git, SSH, tar, gzip;
# VPS: x86_64, Docker + Compose v2 with `up --wait`, SSH user has Docker permission.
# Docker/Compose installation and SSH credentials are a one-time prerequisite.
